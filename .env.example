SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

CLINIC_TIMEZONE=Asia/Karachi
APPOINTMENT_DURATION_MINUTES=30
VOICE_SESSION_TIMEOUT_MINUTES=30

# ---- Local LiveKit ----
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=clinic-booking

# ---- voice_agent (cloud AI stack) ----
DJANGO_API_BASE=http://127.0.0.1:8000/api/

# Groq STT + LLM — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=en
GROQ_LLM_TEMPERATURE=0.2
GROQ_LLM_MAX_TOKENS=120
# Separate TPM budgets; FailoverAdapter walks this list on 429.
GROQ_LLM_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Fish Audio TTS — https://fish.audio
FISH_API_KEY=
FISH_TTS_MODEL=fish-audio/s2.1-pro-free
FISH_BASE_URL=https://api.fish.audio/compat/v1
FISH_VOICE_ID=
FISH_SAMPLE_RATE=24000
FISH_RESPONSE_FORMAT=mp3

# Worker / turn-taking
VOICE_AGENT_PORT=0
VOICE_TURN_SILENCE_SECONDS=0.75
VOICE_MAX_CHAT_ITEMS=14
VAD_ACTIVATION_THRESHOLD=0.65
VAD_MIN_SPEECH_SECONDS=0.25
