SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

CLINIC_TIMEZONE=Asia/Karachi
APPOINTMENT_DURATION_MINUTES=30
VOICE_SESSION_TIMEOUT_MINUTES=30

# ---- Local LiveKit ----
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=clinic-booking

# ---- voice_agent ----
DJANGO_API_BASE=http://127.0.0.1:8000/api/

# ---- DeepSeek LLM — https://platform.deepseek.com ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_COMPLETION_TOKENS=256

# ---- STT: Faster-Whisper (local) ----
# base is clearer than tiny on CPU; use tiny only if the Mac is too slow.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
WHISPER_MIN_AUDIO_SECONDS=0.08

# ---- Fish Audio TTS — https://fish.audio ----
FISH_API_KEY=
FISH_TTS_MODEL=fish-audio/s2.1-pro-free
FISH_BASE_URL=https://api.fish.audio/compat/v1
FISH_VOICE_ID=
FISH_SAMPLE_RATE=24000
FISH_RESPONSE_FORMAT=mp3

# Worker / turn-taking
VOICE_AGENT_PORT=0
VOICE_TURN_SILENCE_SECONDS=0.85
VOICE_MAX_CHAT_ITEMS=14
VAD_ACTIVATION_THRESHOLD=0.72
VAD_MIN_SPEECH_SECONDS=0.35
